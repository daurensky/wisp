<UserControl x:Class="Wisp.Desktop.AttachmentCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Wisp.Desktop"
             HorizontalAlignment="Left" Margin="0,6,0,0">
  <Grid>
    <Grid x:Name="MediaArea" Visibility="Collapsed" MaxWidth="{DynamicResource Width.Media}">
      <Border Background="{DynamicResource VideoBackground}" CornerRadius="{DynamicResource Radius.Control}" ClipToBounds="True">
        <Button x:Name="OpenPreview" Style="{DynamicResource Button.Ghost}" Padding="0" Margin="0"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" BorderThickness="0">
          <Grid x:Name="Preview" MinWidth="160" MinHeight="100" MaxHeight="{DynamicResource Height.Media}">
            <TextBlock x:Name="PreviewState" Text="Загрузка превью…" TextWrapping="Wrap" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="16"/>
          </Grid>
        </Button>
      </Border>
      <Button x:Name="MediaDownload" Style="{DynamicResource Button.Icon}" HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="6" Width="32" Height="32" ToolTip="Скачать вложение" Background="{DynamicResource SurfaceElevated}">
        <local:Icon Kind="download" Width="18" Height="18"/>
      </Button>
    </Grid>
    <Border x:Name="FileArea" MaxWidth="{DynamicResource Width.Media}" MinWidth="230" Background="{DynamicResource SurfaceElevated}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Control}" Padding="12">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <local:Icon x:Name="FileIcon" Kind="file" Width="28" Height="32" Margin="0,0,12,0"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="FileName" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="FileSize" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource Font.Caption}"/>
        </StackPanel>
        <Button x:Name="FileDownload" Grid.Column="2" Style="{DynamicResource Button.Icon}" Margin="8,0,0,0" ToolTip="Скачать вложение">
          <local:Icon Kind="download"/>
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>
