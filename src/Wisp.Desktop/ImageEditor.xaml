<UserControl x:Class="Wisp.Desktop.ImageEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="320">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="VisibleWhen"/>
    <Style x:Key="EditorActionText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </UserControl.Resources>
  <Grid Margin="24,0,24,20">
    <Grid.RowDefinitions>
      <RowDefinition/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="152"/>
      </Grid.ColumnDefinitions>
      <Border Background="{DynamicResource VideoBackground}" CornerRadius="{DynamicResource Radius.Control}" Margin="0,0,16,0">
        <Canvas x:Name="Viewport" ClipToBounds="True" Background="Transparent"
                IsEnabled="{Binding CanEdit}" SizeChanged="ViewportSizeChanged"
                MouseLeftButtonDown="StartDrag" MouseMove="Drag" MouseLeftButtonUp="FinishDrag" MouseWheel="ZoomWheel">
          <Image x:Name="SourceImage" Stretch="Fill" IsHitTestVisible="False"/>
          <Path x:Name="OutsideShade" Fill="{DynamicResource Overlay}" IsHitTestVisible="False"/>
          <Path x:Name="CropOutline" Stroke="{DynamicResource FocusRing}" StrokeThickness="1" IsHitTestVisible="False"/>
        </Canvas>
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="Результат" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
        <Border x:Name="ResultBorder" Width="144" Height="144" HorizontalAlignment="Left" Background="{DynamicResource VideoBackground}">
          <Rectangle x:Name="ResultImage">
            <Rectangle.Fill>
              <ImageBrush x:Name="ResultBrush" ImageSource="{Binding Source, ElementName=SourceImage}" Stretch="Fill" ViewboxUnits="RelativeToBoundingBox"/>
            </Rectangle.Fill>
          </Rectangle>
        </Border>
        <TextBlock x:Name="OutputShape" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" Margin="0,16,0,0" IsEnabled="{Binding CanEdit}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="Масштаб" Foreground="{DynamicResource TextSecondary}" Margin="0,0,12,0" VerticalAlignment="Center"/>
      <Slider Grid.Column="1" Minimum="1" Maximum="8" Value="{Binding Zoom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" ToolTip="Масштаб изображения"/>
      <Button Grid.Column="2" Content="Сбросить" Margin="12,0,0,0" Click="Reset" ToolTip="Сбросить обрезку и масштаб"/>
    </Grid>
    <Grid Grid.Row="2" Margin="0,12,0,0" Visibility="{Binding Animated, Converter={StaticResource VisibleWhen}}" IsEnabled="{Binding CanEdit}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="Статичная обложка GIF" Foreground="{DynamicResource TextSecondary}"/>
      <TextBlock x:Name="FrameLabel" Grid.Column="1" Foreground="{DynamicResource TextSecondary}" Margin="12,0,0,0"/>
      <Slider Grid.Row="1" Minimum="0" Maximum="{Binding MaximumFrame}" TickFrequency="1" IsSnapToTickEnabled="True"
              Value="{Binding CoverFrame, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Кадр статичной обложки" Margin="0,8,12,0"/>
      <Button x:Name="PreviewPlayback" Grid.Row="1" Grid.Column="1" Content="Воспроизвести" Click="TogglePlayback" Margin="0,8,0,0"/>
    </Grid>
    <StackPanel Grid.Row="3" Margin="0,12,0,0">
      <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,4,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Style="{DynamicResource Button.Ghost}" Click="Cancel" ToolTip="Отмена · Esc">
        <TextBlock Text="Отмена" Style="{StaticResource EditorActionText}"/>
      </Button>
      <Button Style="{DynamicResource Button.Primary}" IsEnabled="{Binding CanSave}" Click="Save" ToolTip="Сохранить обрезку">
        <TextBlock x:Name="SaveLabel" Text="Сохранить" Style="{StaticResource EditorActionText}"/>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
