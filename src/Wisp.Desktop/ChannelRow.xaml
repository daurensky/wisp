<UserControl x:Class="Wisp.Desktop.ChannelRow"
             x:Name="ChannelRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Wisp.Desktop"
             local:PointerFocus.Track="True" Focusable="False"
             Margin="4,0" Background="Transparent">
  <UserControl.Resources>
    <!-- The channel action occupies one zone of the row. Hover belongs to the
         common row surface, while keyboard focus belongs to the actual button. -->
    <Style x:Key="ChannelAction" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Padding" Value="{StaticResource Padding.Row}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="MinHeight" Value="{StaticResource Size.Row}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>
              <Border x:Name="FocusRing" CornerRadius="{StaticResource Radius.Control}"
                      BorderThickness="1" BorderBrush="{DynamicResource FocusRing}"
                      IsHitTestVisible="False" Opacity="0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="local:PointerFocus.KeyboardFocus" Value="True">
                <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ChannelTool" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
      <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ChannelSettingsTool" TargetType="Button" BasedOn="{StaticResource ChannelTool}">
      <!-- Hidden reserves the same hit geometry when hover begins/ends. -->
      <Setter Property="Visibility" Value="Hidden"/>
      <Style.Triggers>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsVoice, ElementName=ChannelRoot}" Value="False"/>
            <Condition Binding="{Binding IsSelected, ElementName=ChannelRoot}" Value="True"/>
          </MultiDataTrigger.Conditions>
          <Setter Property="Visibility" Value="Visible"/>
        </MultiDataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsVoice, ElementName=ChannelRoot}" Value="True"/>
            <Condition Binding="{Binding IsMouseOver, ElementName=ChannelRoot}" Value="True"/>
            <Condition Binding="{Binding Path=(local:PointerFocus.IsWindowActive), ElementName=ChannelRoot}" Value="True"/>
          </MultiDataTrigger.Conditions>
          <Setter Property="Visibility" Value="Visible"/>
        </MultiDataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsVoice, ElementName=ChannelRoot}" Value="True"/>
            <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=ChannelRoot}" Value="True"/>
            <Condition Binding="{Binding Path=(local:PointerFocus.KeyboardFocus), ElementName=ChannelRoot}" Value="True"/>
            <Condition Binding="{Binding Path=(local:PointerFocus.IsWindowActive), ElementName=ChannelRoot}" Value="True"/>
          </MultiDataTrigger.Conditions>
          <Setter Property="Visibility" Value="Visible"/>
        </MultiDataTrigger>
        <DataTrigger Binding="{Binding CanManage, ElementName=ChannelRoot}" Value="False">
          <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <Border x:Name="RowChrome" CornerRadius="{StaticResource Radius.Control}">
    <Border.Style>
      <Style TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Binding="{Binding IsMouseOver, ElementName=ChannelRoot}" Value="True"/>
              <Condition Binding="{Binding Path=(local:PointerFocus.IsWindowActive), ElementName=ChannelRoot}" Value="True"/>
            </MultiDataTrigger.Conditions>
            <Setter Property="Background" Value="{DynamicResource Hover}"/>
          </MultiDataTrigger>
          <DataTrigger Binding="{Binding IsSelected, ElementName=ChannelRoot}" Value="True">
            <Setter Property="Background" Value="{DynamicResource Selected}"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Border.Style>
    <Grid Margin="0,0,4,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button x:Name="ChannelButton" Style="{StaticResource ChannelAction}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <local:Icon x:Name="ChannelIcon" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="ChannelName" Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          <TextBlock x:Name="ParticipantCount" Grid.Column="2" Margin="8,0,0,0"
                     Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource Font.Caption}" VerticalAlignment="Center"/>
        </Grid>
      </Button>
      <Button x:Name="VoiceChatButton" Grid.Column="1">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource ChannelTool}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsVoice, ElementName=ChannelRoot}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
          </Style>
        </Button.Style>
        <local:Icon Kind="message-square"/>
      </Button>
      <Button x:Name="ChannelSettingsButton" Grid.Column="2" Style="{StaticResource ChannelSettingsTool}">
        <local:Icon Kind="settings"/>
      </Button>
    </Grid>
  </Border>
</UserControl>
