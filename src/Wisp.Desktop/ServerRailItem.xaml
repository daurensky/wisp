<UserControl x:Class="Wisp.Desktop.ServerRailItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="56" Focusable="False">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border x:Name="ActivePill" Width="{StaticResource Width.ServerPill}" Height="0"
            Background="{DynamicResource TextPrimary}" CornerRadius="2" VerticalAlignment="Center"
            IsHitTestVisible="False"/>
    <Button x:Name="ServerButton" Grid.Column="1" Style="{StaticResource Button.Ghost}"
            Width="{StaticResource Size.RailItem}" Height="{StaticResource Size.RailItem}"
            Padding="0" Margin="0" BorderThickness="0" HorizontalAlignment="Center"
            VerticalAlignment="Center"/>
  </Grid>
</UserControl>
