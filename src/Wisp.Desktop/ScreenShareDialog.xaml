<UserControl x:Class="Wisp.Desktop.ScreenShareDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Wisp.Desktop">
 <Grid Margin="24,0,24,20">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ContentControl x:Name="SourceContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  <Grid Grid.Row="1" Margin="0,12,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,12,0">
    <TextBlock Text="Разрешение" Style="{DynamicResource Text.Section}" Margin="0,0,0,4"/>
    <ComboBox ItemsSource="{Binding Resolutions}" DisplayMemberPath="Label" SelectedIndex="{Binding ResolutionIndex,Mode=TwoWay}" AutomationProperties.Name="Разрешение демонстрации"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Margin="0,0,12,0">
    <TextBlock Text="FPS" Style="{DynamicResource Text.Section}" Margin="0,0,0,4"/>
    <ComboBox ItemsSource="{Binding FrameRates}" DisplayMemberPath="Label" SelectedIndex="{Binding FrameRateIndex,Mode=TwoWay}" AutomationProperties.Name="Частота кадров демонстрации"/>
   </StackPanel>
   <StackPanel Grid.Column="2" Margin="0,0,12,0">
    <TextBlock Text="Битрейт" Style="{DynamicResource Text.Section}" Margin="0,0,0,4"/>
    <ComboBox ItemsSource="{Binding Bitrates}" DisplayMemberPath="Label" SelectedIndex="{Binding BitrateIndex,Mode=TwoWay}" AutomationProperties.Name="Битрейт демонстрации"/>
   </StackPanel>
   <Button x:Name="LaunchButton" Grid.Column="3" Content="Запустить" IsDefault="True" IsEnabled="{Binding CanLaunch}" VerticalAlignment="Bottom" Style="{DynamicResource Button.Primary}" Click="LaunchClicked" AutomationProperties.Name="Запустить демонстрацию"/>
  </Grid>
 </Grid>
</UserControl>
