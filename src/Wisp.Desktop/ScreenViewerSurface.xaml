<UserControl x:Class="Wisp.Desktop.ScreenViewerSurface"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Wisp.Desktop"
 Focusable="True">
 <UserControl.Resources>
  <Style x:Key="StreamButton" TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource VideoForeground}"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
   <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
   <Setter Property="Margin" Value="2,0"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="local:PointerFocus.Track" Value="True"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Grid>
       <Border Background="{TemplateBinding Background}" CornerRadius="8"/>
       <Border x:Name="Hover" Background="{DynamicResource VideoControlHover}" CornerRadius="8" Opacity="0" IsHitTestVisible="False"/>
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <Border x:Name="Focus" BorderBrush="{DynamicResource VideoForeground}" BorderThickness="1" CornerRadius="8" Opacity="0" IsHitTestVisible="False"/>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="local:PointerFocus.PointerOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value=".45"/></Trigger>
       <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsPressed" Value="True"/><Condition Property="local:PointerFocus.IsWindowActive" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Hover" Property="Opacity" Value=".75"/></MultiTrigger>
       <Trigger Property="local:PointerFocus.KeyboardFocus" Value="True"><Setter TargetName="Focus" Property="Opacity" Value="1"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </UserControl.Resources>
 <Grid x:Name="Viewport" Background="{DynamicResource VideoBackground}">
  <Image x:Name="VideoImage" Stretch="Uniform" SnapsToDevicePixels="True"/>
  <TextBlock x:Name="Caption" Foreground="{DynamicResource VideoForeground}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="16" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
  <ScrollViewer x:Name="ViewersScroll" HorizontalAlignment="Right" VerticalAlignment="Top" MaxHeight="76" MaxWidth="320" Margin="12" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
   <WrapPanel x:Name="ViewerAvatars" HorizontalAlignment="Right"/>
  </ScrollViewer>
  <TextBlock x:Name="Status" Text="Подключение к трансляции…" Foreground="{DynamicResource VideoForeground}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" IsHitTestVisible="False"/>
  <Border x:Name="Toolbar" Background="{DynamicResource VideoControlSurface}" CornerRadius="12" Padding="6" Margin="12" HorizontalAlignment="Center" VerticalAlignment="Bottom">
   <StackPanel Orientation="Horizontal">
    <Button x:Name="MiniButton" Style="{StaticResource StreamButton}" ToolTip="Уменьшить / развернуть" AutomationProperties.Name="Уменьшить просмотр"><local:Icon Kind="arrow-down-right" Width="18" Height="18"/></Button>
    <Button x:Name="FullscreenButton" Style="{StaticResource StreamButton}" ToolTip="На весь экран · F11" AutomationProperties.Name="Полноэкранный просмотр"><local:Icon Kind="maximize" Width="18" Height="18"/></Button>
    <Button x:Name="MuteButton" Style="{StaticResource StreamButton}" ToolTip="Выключить звук демонстрации" AutomationProperties.Name="Выключить звук демонстрации"><local:Icon Kind="volume-2" Width="18" Height="18"/></Button>
    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="100" Width="88" Margin="6,0" VerticalAlignment="Center" ToolTip="Громкость демонстрации" AutomationProperties.Name="Громкость демонстрации"/>
    <Button x:Name="CloseButton" Style="{StaticResource StreamButton}" ToolTip="Закрыть просмотр" AutomationProperties.Name="Закрыть просмотр"><local:Icon Kind="x" Width="18" Height="18"/></Button>
   </StackPanel>
  </Border>
 </Grid>
</UserControl>
