<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows10.0.22621.0</TargetFramework><UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><EnableWindowsTargeting>true</EnableWindowsTargeting><SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion><ImplicitUsings>disable</ImplicitUsings><Nullable>enable</Nullable><ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Wisp</AssemblyName><ApplicationIcon>Assets/wisp.ico</ApplicationIcon><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Wisp.Core/Wisp.Core.csproj" /><PackageReference Include="NAudio" Version="2.2.1" /><PackageReference Include="Concentus" Version="2.2.2" /></ItemGroup>
  <ItemGroup><PackageReference Include="XamlAnimatedGif" Version="2.3.2" /><Resource Include="Assets/wisp.png" /><Resource Include="Assets/app-logo.png" /><Resource Include="Assets/wisp.ico" /></ItemGroup>
  <ItemGroup><PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" /></ItemGroup>
  <ItemGroup><Content Include="../../docs/licenses/SIPSorcery.md" Link="licenses/SIPSorcery.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Content Include="../../docs/licenses/ASSETS.md" Link="licenses/ASSETS.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /><Content Include="../../docs/licenses/XamlAnimatedGif-Apache-2.0.txt" Link="licenses/XamlAnimatedGif-Apache-2.0.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
<ItemGroup><PackageReference Include="Concentus.Native.NetCore" Version="1.5.2" /></ItemGroup>
<ItemGroup><Content Include="../../docs/licenses/Opus.txt" Link="licenses/Opus.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/><Content Include="../../docs/licenses/Vortice-MIT.txt" Link="licenses/Vortice-MIT.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/></ItemGroup>
<ItemGroup><PackageReference Include="Vortice.Direct3D11" Version="3.8.3" /></ItemGroup>
  <PropertyGroup><RnNoiseBinary>$(MSBuildThisFileDirectory)../../artifacts/native/rnnoise.dll</RnNoiseBinary></PropertyGroup>
  <ItemGroup><Content Include="../../docs/licenses/Lucide.txt" Link="licenses/Lucide.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup>
    <Content Include="$(RnNoiseBinary)" Condition="Exists('$(RnNoiseBinary)')" Link="rnnoise.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/licenses/RNNoise.txt" Link="licenses/RNNoise.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireRnNoiseForDistribution" BeforeTargets="Publish" Condition="'$(RequireRnNoise)' == 'true'">
    <Error Condition="!Exists('$(RnNoiseBinary)')" Text="Build native/rnnoise before publishing with RequireRnNoise=true." />
  </Target>
</Project>
